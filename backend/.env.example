# Copy to .env for local development. Never commit .env or real credentials.
APP_NAME=Festivo AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# IANA timezone used to decide whether an event date has already passed.
APP_TIMEZONE=Asia/Kolkata

# Use "memory" for local development. Production requires "postgres".
# The database URL is a secret: never commit it or expose it to the frontend.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
STORAGE_BACKEND=memory
# SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
SUPABASE_DB_CONNECT_TIMEOUT_SECONDS=10

# Authentication: the API requires a Supabase access token unless a test verifier is injected.
# SUPABASE_URL derives both the JWKS and issuer; explicit overrides are also supported.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=30

# Browser credentials belong in the frontend environment, never in this backend file.
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# One or more explicit browser origins. Use FRONTEND_ORIGINS for a comma-separated
# list or a JSON array when the frontend is served from multiple origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM features remain disabled unless LLM_ENABLED=true.
# Use a currently supported Gemini model id from Google AI Studio/Gemini API.
# Do not rely on unverified model names; confirm availability for your project.
LLM_PROVIDER=gemini
LLM_MODEL=replace_with_verified_supported_model_id
GEMINI_API_KEY=
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.4

# AI proposals expire unless approved or rejected within this window (1-720 hours).
PROPOSAL_TTL_HOURS=168

DEBUG=false

# Optional overrides. Defaults: enabled outside production, disabled in production.
# DOCS_ENABLED=
# CONFIG_STATUS_ENABLED=
